# ── Firebase (client config; safe to expose) ──────────────────────────────────
# Email/Password authentication + Firestore.
# Data is stored in one shared document read by signed-in accounts:
#   workspaces/main
# Firebase Console → Project settings → Your apps → Web app → SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Gemini proxy (server-side only, never expose to the browser) ──────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: route Gemini requests through a compatible gateway or a
# supported-region proxy if your network location is restricted.
# GEMINI_API_BASE=https://generativelanguage.googleapis.com

# Optional: URL of a separately deployed AI proxy (server/index.js).
# Leave empty to use this app's own /api proxy.
# VITE_AI_API_BASE=https://your-ai-proxy.example.com

PORT=3001
