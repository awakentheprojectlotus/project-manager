# ── Firebase (client config; safe to expose) ──────────────────────────────────
# Email/Password authentication + Firestore.
# Data is stored in one shared document read by signed-in accounts:
#   workspaces/main
# Firebase Console → Project settings → Your apps → Web app → SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── AI provider (server-side only, never expose these keys) ───────────────────
# OpenCode Go subscription (default) or OpenCode Console/Zen credits.
# Create/copy the key at https://opencode.ai/console
AI_PROVIDER=opencode
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4.1-flash
# Go subscription endpoint (default)
# OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
# Zen pay-as-you-go endpoint
# OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1

# Alternative: Google Gemini. May be region-restricted.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API_BASE=https://generativelanguage.googleapis.com

# Optional: URL of a separately deployed AI proxy (server/index.js).
# VITE_AI_API_BASE=https://your-ai-proxy.example.com

PORT=3001
